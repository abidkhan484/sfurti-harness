# Configuration file plus explicit count overrides.
# Copy to .env. Never place credentials in this example.
SFURTI_CONFIG=./config/harness.json

# Uncomment only to override counts from the configuration file.
# DAILY_VIDEO_COUNT=3
# DAILY_IMAGE_COUNT=1
# DAILY_TEXT_COUNT=1

# Research mode remains disabled until the separately documented local and
# live-readiness gates are complete. Keep secrets in an uncommitted .env file.
SFURTI_RESEARCH_ENABLED=false
SFURTI_COGNEE_BASE_URL=http://127.0.0.1:18000
SFURTI_COGNEE_TOKEN=

# Codex authentication and external tool credentials are configured during
# integration setup. Names and requirements must match the verified adapters.
# Keep actual values in .env only; these names are references, never example secrets.
# SFURTI_FACEBOOK_PAGE_TOKEN=
