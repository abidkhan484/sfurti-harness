# Configuration file plus explicit count overrides.
# Copy to .env. Never place credentials in this example.
SFURTI_CONFIG=./config/harness.json

# Uncomment only to override counts from the configuration file.
# DAILY_VIDEO_COUNT=3
# DAILY_IMAGE_COUNT=1
# DAILY_TEXT_COUNT=1

# Codex authentication and external tool credentials are configured during
# integration setup. Names and requirements must match the verified adapters.
